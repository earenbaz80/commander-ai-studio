{
  "version": 1,
  "providers": {
    "google": {
      "defaultModel": "gemini-3.5-flash",
      "toolsMemoryTtlMinutes": 30
    }
  },
  "tools": {
    "mcp": {
      "enabled": true,
      "servers": {
        "myserver": {
          "command": "python",
          "args": [
            "-m",
            "myserver"
          ]
        },
        "rea": {
          "command": "C:\\Program Files\\nodejs\\node.exe",
          "args": [
            "C:\\Tools\\rea\\launch-rea.mjs",
            "mcp"
          ],
          "env": {
            "REA_ADB_PATH": "C:\\Users\\Edel Arencibia Baez\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe"
          }
        },
        "assetmcp": {
          "command": "C:\\Users\\Edel Arencibia Baez\\Tools\\ASSETMCP\\.venv\\Scripts\\python.exe",
          "args": [
            "-m",
            "assetmcp.server"
          ],
          "env": {
            "ASSETMCP_LIBRARY_DIR": "C:\\Users\\Edel Arencibia Baez\\Documents\\Proyectos\\eko-cobra-tactical\\AssetLibrary",
            "ASSETMCP_PREVIEW_DIR": "C:\\Users\\Edel Arencibia Baez\\Documents\\Proyectos\\eko-cobra-tactical\\AssetLibrary\\previews"
          }
        },
        "context7": {
          "command": "C:\\Program Files\\nodejs\\npx.cmd",
          "args": [
            "-y",
            "@upstash/context7-mcp"
          ]
        },
        "engram": {
          "command": "C:\\Users\\Edel Arencibia Baez\\AppData\\Local\\engram\\bin\\engram.exe",
          "args": [
            "mcp",
            "--tools=agent"
          ]
        },
        "chrome-devtools": {
          "command": "C:\\Program Files\\nodejs\\npx.cmd",
          "args": [
            "-y",
            "chrome-devtools-mcp@latest",
            "--no-usage-statistics"
          ]
        },
        "pixelforge": {
          "command": "C:\\\\Program Files\\\\nodejs\\\\node.exe",
          "args": [
            "C:\\\\Users\\\\Edel Arencibia Baez\\\\AppData\\\\Roaming\\\\npm\\\\node_modules\\\\pixelforge-mcp\\\\dist\\\\index.js"
          ],
          "env": {
            "GEMINI_API_KEY": "${PIXELFORGE_GEMINI_API_KEY}"
          }
        }
      }
    }
  },
  "ui": {
    "theme": "matrix",
    "language": "es",
    "showTooltips": true,
    "lowResourceMode": false,
    "powerSaverMode": false,
    "fontScale": "normal",
    "compactMode": false,
    "sidebarWidth": 280,
    "rightPanelWidth": 380
  },
  "shortcuts": {
    "palette": "Ctrl+K",
    "inspector": "Ctrl+,",
    "sidebar": "Ctrl+B",
    "newPrompt": "Ctrl+Alt+N",
    "workbench": "Ctrl+Alt+B",
    "saveVersion": "Ctrl+S",
    "compiler": "Ctrl+Alt+C",
    "newTab": "Ctrl+T",
    "closeTab": "Ctrl+W",
    "generalAudit": "Ctrl+Shift+G",
    "shortcutsHelp": "Ctrl+/",
    "voice": "Ctrl+Alt+V"
  },
  "agent": {
    "maxSteps": 50,
    "maxTurns": 10,
    "approvalMode": "manual",
    "planMode": false,
    "autoCompact": true,
    "contextWindow": 128000
  },
  "server": {
    "port": 3280,
    "host": "127.0.0.1",
    "corsOrigins": [],
    "enableAuth": false
  },
  "projects": {
    "allowList": [],
    "autoAddCwd": true
  },
  "telemetry": {
    "enabled": false
  },
  "experimental": {
    "streamingParser": false,
    "wasmSandbox": false,
    "multiAgent": false
  }
}
