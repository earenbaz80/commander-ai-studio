{
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "release-build",
    "release-packager",
    "staging",
    "src-tauri",
    "build",
    "vscode-extension",
    "playwright-report",
    "test-results",
    "screenshots",
    "local_models",
    "runtime",
    "electron/runtime",
    "electron/server.cjs",
    "electron/server.mjs",
    ".commander",
    "tests/tmp",
    "tests/tmp-*",
    "tests/e2e",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
