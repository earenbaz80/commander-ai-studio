{
  "name": "commander-ai-studio",
  "version": "2.5.0",
  "description": "Commander AI Studio - Multi-model AI IDE",
  "author": "Edel Arencibia Baez",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm run build:server:cjs && npm run build:server:mjs",
    "build:server:cjs": "npx esbuild server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=electron/server.cjs",
    "build:server:mjs": "npx esbuild server.ts --bundle --platform=node --format=esm --target=node20 --outfile=electron/server.mjs",
    "build:electron": "electron-builder --win",
    "build:all": "npm run build && npm run build:server && npm run build:electron",
    "build:tauri": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "ELECTRON_START_URL=http://localhost:5173 npm run electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky install",
    "postinstall": "electron-builder install-app-deps",
    "capacitor:add": "cap add android ios",
    "capacitor:sync": "cap sync",
    "capacitor:open:android": "cap open android",
    "capacitor:open:ios": "cap open ios",
    "pwa:generate": "workbox generateSW workbox-config.js",
    "db:migrate": "tsx scripts/migrate-firebase.ts",
    "skills:import": "tsx bin/commander.ts skills import",
    "tauri:info": "tauri info",
    "tauri:icon": "tauri icon"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@google/genai": "^2.25.0",
    "@google/generative-ai": "^0.24.1",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "canvas-confetti": "^1.9.4",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "jszip": "^3.10.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-language-server": "^6.0.2",
    "vitest": "^5.0.4"
  },
  "devDependencies": {
    "electron-builder": "^26.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.commander.ai.studio",
    "productName": "Commander AI Studio",
    "copyright": "Copyright © 2026 Edel Arencibia Baez",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "resources/**/*",
      "!**/node_modules/*",
      "!**/.git/*"
    ],
    "extraResources": [
      {
        "from": "electron/server.cjs",
        "to": "server.cjs"
      },
      {
        "from": "electron/server.mjs",
        "to": "server.mjs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Commander AI Studio"
    },
    "publish": {
      "provider": "github",
      "owner": "EdelArencibia",
      "repo": "commander-ai-studio"
    }
  },
  "capacitor": {
    "appId": "com.commander.ai.studio",
    "appName": "Commander AI Studio",
    "webDir": "dist",
    "server": {
      "url": "http://localhost:5173",
      "cleartext": true
    }
  }
}