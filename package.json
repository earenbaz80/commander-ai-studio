{
  "name": "commander-ai-studio",
  "version": "2.5.1",
  "type": "module",
  "description": "Commander AI Studio - Multi-model AI IDE",
  "author": {
    "name": "Edel Arencibia Baez",
    "email": "earenbaz80@users.noreply.github.com"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development npx tsx server.ts",
    "dev:legacy": "concurrently \"cross-env NODE_ENV=development npx tsx server.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm run build:server:cjs && npm run build:server:mjs",
    "build:server:cjs": "npx esbuild server.ts --bundle --platform=node --format=cjs --target=node20 --external:vite --external:playwright --external:node-pty --outfile=electron/server.cjs",
    "build:server:mjs": "npx esbuild server.ts --bundle --platform=node --format=esm --target=node20 --external:vite --external:playwright --external:node-pty --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=electron/server.mjs",
    "build:electron": "electron-builder --win",
    "build:all": "npm run build && npm run build:server && npm run build:updater && npm run build:electron",
    "build:tauri": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "deploy:example": "tsx scripts/deploy-example.ts",
    "electron": "electron .",
    "electron:dev": "ELECTRON_START_URL=http://localhost:5173 npm run electron",
    "test": "vitest run",
    "test:node": "tsx scripts/test-node.ts",
    "test:logic": "vitest run --project node",
    "eval": "tsx evals/run.ts",
    "eval:live": "cross-env EVAL_LIVE=1 tsx evals/run.ts",
    "eval:strict": "tsx evals/run.ts --strict-scope",
    "eval:history": "tsx evals/run.ts --history",
    "eval:wait": "tsx evals/wait-quota.ts",
    "models:freebuff": "node scripts/sync-freebuff-models.mjs",
    "models:probe": "node scripts/probe-models.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src && tsx scripts/check-rules.ts",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "check:index": "tsx scripts/check-index.ts",
    "check:issue-status": "tsx scripts/sync-issue-status.ts --check",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "sync:issue-status": "tsx scripts/sync-issue-status.ts",
    "check:rules": "tsx scripts/check-rules.ts",
    "check:contrast": "npm run build && playwright test tests/e2e/contrast.spec.ts --project=chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky install",
    "postinstall": "electron-builder install-app-deps",
    "capacitor:add": "cap add android ios",
    "capacitor:sync": "cap sync",
    "capacitor:open:android": "cap open android",
    "capacitor:open:ios": "cap open ios",
    "pwa:generate": "workbox generateSW workbox-config.js",
    "db:migrate": "tsx scripts/migrate-firebase.ts",
    "skills:import": "tsx bin/commander.ts skills import",
    "tauri:info": "tauri info",
    "tauri:icon": "tauri icon",
    "build:updater": "npx esbuild electron/updaterEntry.cjs --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=electron/updater.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@google/genai": "^2.25.0",
    "@google/generative-ai": "^0.24.1",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^12.1.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-language-server": "^6.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.commander.ai.studio",
    "productName": "Commander AI Studio",
    "npmRebuild": false,
    "afterPack": "scripts/afterPack.cjs",
    "copyright": "Copyright © 2026 Edel Arencibia Baez",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/updater.cjs",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/lspBridge.cjs",
      "public/**/*",
      "resources/**/*",
      "!electron/.commander/**",
      "!electron/.agent-roots.json",
      "!**/node_modules/**/*",
      "!**/.git/*"
    ],
    "electronLanguages": [
      "en-US",
      "es",
      "de"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "electron/server.cjs",
        "to": "server.cjs"
      },
      {
        "from": "node_modules/node-pty",
        "to": "node_modules/node-pty"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "Development"
    },
    "nsis": {
      "artifactName": "Commander-AI-Studio-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Commander AI Studio"
    },
    "publish": {
      "provider": "github",
      "owner": "earenbaz80",
      "repo": "commander-ai-studio"
    }
  },
  "capacitor": {
    "appId": "com.commander.ai.studio",
    "appName": "Commander AI Studio",
    "webDir": "dist",
    "server": {
      "url": "http://localhost:5173",
      "cleartext": true
    }
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-winstaller": true,
    "esbuild@0.28.2": true
  }
}
