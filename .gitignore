bun.lock

# Secretos — NUNCA commitear
.env
.env.local
.env.*.local

# Build
dist/
release/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tauri (retirado del repo) y artefactos nativos
src-tauri/
target/

# Tests temporales
tests/tmp/
tests/tmp-evals/

# Registro local de proyectos del agente (permisos por máquina)
.agent-roots.json

# Artefactos de empaquetado (¡11 GB!)
release-packager/
staging/

# Reportes de tests E2E
playwright-report/
test-results/

# Capturas locales de revisión visual (se regeneran, no son fuente)
screenshots/

# Modelos locales descargados (pesan GB, se re-descargan)
local_models/

# Estado interno de Commander
.commander/
runtime/

# Logs y salidas de build
build.log
build_output.txt
test-output.txt
vitest-output.txt

# Servidores empaquetados (los genera `npm run build:server`, ~3.4 MB cada uno)
electron/server.cjs
electron/server.mjs

# Archivos de notas sueltas en la raíz
agentmode.txt
block.txt
block2.txt

# build/ NO se ignora: contiene los íconos que usa electron-builder

# ── Artefactos de ejecución en la raíz ──────────────────────────────
# Volcados de build/tests y notas sueltas: nunca son fuente ni documentación.
/*.txt

# Parcheos ad-hoc ya aplicados. Los scripts de verdad viven en scripts/ y bin/.
/*.py
/*.ps1
/*.bat

# .js que `tsc` deja junto al fuente cuando se compila un fichero suelto.
# El build del proyecto es `tsc --noEmit` + vite/esbuild, que nunca emite ahí.
# eslint.config.js está versionado, así que no le afecta esta regla.
/agentTools.js
/apiKeys.js
/security.js
