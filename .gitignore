# Dependencias
node_modules/

# bun.lock es un artefacto del template (stale, no usar)
bun.lock

# Secretos — NUNCA commitear
.env
.env.local
.env.*.local

# Build
dist/
cli-dist/
release/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tauri (retirado del repo) y artefactos nativos
src-tauri/
target/

# Tests temporales: restos de corridas locales (eval, G1, checkpoints, búsquedas).
# Los tests de verdad escriben en os.tmpdir(); esto sólo evita versionar lo que
# dejan los scripts a mano.
tests/tmp/
tests/tmp-*/
# Volcados de sesión de la línea base (diagnóstico de fallos T10)
evals/traces/

# Registro local de proyectos del agente (permisos por máquina)
.agent-roots.json

# Volcado de conversaciones importadas: material de trabajo, no fuente
.cloud-attachments/

# Artefactos de empaquetado (¡11 GB!)
release-packager/
staging/

# Reportes de tests E2E
playwright-report/
blob-report/
test-results/

# Reportes máquina-legibles que `ci:summary` convierte en el resumen del job
# (JUnit de node:test, JSON de Vitest). También se escriben en local.
.ci/

# Capturas locales de revisión visual (se regeneran, no son fuente)
screenshots/
# Capturas sueltas en la raíz (mismo criterio: se regeneran, no son fuente).
/screenshot-*.png

# Modelos locales descargados (pesan GB, se re-descargan)
local_models/

# Estado interno de Commander
.commander/
runtime/

# Artefactos del analizador REA (logs y volcados grandes): material de trabajo
/.rea/

# Plugins y skills instalados desde el catálogo: se regeneran al instalar y no
# son fuente del proyecto. Las skills propias (skills/agents, skills/commands)
# siguen versionadas.
skills/plugins/

# Logs y salidas de build
build.log
build_output.txt
test-output.txt
vitest-output.txt

# Servidores empaquetados (los genera `npm run build:server`, ~3.4 MB cada uno)
electron/server.cjs
electron/server.mjs
electron/updater.cjs

# Archivos de notas sueltas en la raíz
agentmode.txt
block.txt
block2.txt

# build/ NO se ignora: contiene los íconos que usa electron-builder

# ── Artefactos de ejecución en la raíz ──────────────────────────────
# Volcados de build/tests y notas sueltas: nunca son fuente ni documentación.
/*.txt

# Parcheos ad-hoc ya aplicados. Los scripts de verdad viven en scripts/ y bin/.
/*.py
/*.ps1
/*.bat

# .js que `tsc` deja junto al fuente cuando se compila un fichero suelto.
# El build del proyecto es `tsc --noEmit` + vite/esbuild, que nunca emite ahí.
# eslint.config.js está versionado, así que no le afecta esta regla.
/agentTools.js
/apiKeys.js
/security.js
release-build/
release-x64/

# Restos de ejecuciones locales
*.pid
pty-validacion-*.png

# Datos locales de la app de ejemplo (PL3)
examples/pl3-backend-app/.data/

# Racha de flaky que el gate de CI arrastra por cache (no se commitea)
.flaky-state.json
