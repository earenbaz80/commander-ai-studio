{
  "name": "commander-ai-studio",
  "displayName": "Commander AI Studio",
  "description": "Agente de código y colaboración de Commander AI Studio dentro de VS Code.",
  "version": "0.1.0",
  "publisher": "commander-ai-studio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commander.openChat",
        "title": "Commander: Abrir chat del agente"
      },
      {
        "command": "commander.openStudio",
        "title": "Commander: Abrir Studio",
        "category": "Commander"
      },
      {
        "command": "commander.runAgent",
        "title": "Commander: Ejecutar agente sobre una tarea",
        "category": "Commander"
      }
    ],
    "configuration": {
      "title": "Commander AI Studio",
      "properties": {
        "commander.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3280",
          "description": "URL del servidor embebido de Commander AI Studio."
        },
        "commander.cliCommand": {
          "type": "string",
          "default": "npx commander",
          "description": "Comando del CLI para lanzar el agente headless."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
