# ══════════════════════════════════════════════════════════════
#  Commander AI Studio — variables de entorno
#  Copia este archivo como .env y rellena lo que necesites:
#    cp .env.example .env
#  .env NUNCA se commitea (ver .gitignore).
# ══════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────
# Puerto del server de dev/prod (default 3000)
PORT=3000
# Interfaz de escucha: 127.0.0.1 por defecto (los endpoints del agente no se
# exponen a la LAN). Solo usa 0.0.0.0 si sabes lo que haces.
HOST=127.0.0.1
# production desactiva /api/debug/* y marca las cookies como secure
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma
# (3280 = Electron embebido)
CORS_ORIGINS=http://localhost:3000,http://localhost:3280
# Nombres de Host aceptados además de loopback/IP literal. El server rechaza
# (403) cualquier otro Host para que un dominio ajeno no pueda resolverse a
# 127.0.0.1 y hablarle (DNS rebinding). Rellénalo solo si sirves la app por un
# nombre propio, ej. commander.local
# ALLOWED_HOSTS=commander.local

# ── Proveedores cloud (opcionales) ────────────────────────────
# Google Gemini — requerido para /api/gemini/* y el Modo Agente nativo
GEMINI_API_KEY=
# Anthropic Claude — requerido para /api/anthropic/*
ANTHROPIC_API_KEY=
# OpenRouter — /api/openrouter/*
OPENROUTER_API_KEY=
# Endpoint OpenAI-compatible propio — /api/custom/*
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
# Modelo por defecto del endpoint custom (ej. gpt-4o-mini, llama-3.3-70b)
CUSTOM_MODEL=
# Freebuff — /api/freebuff/* (API OpenAI-compatible con su propio catálogo)
# La clave se crea en Freebuff → Account → Developer API.
FREEBUFF_API_KEY=
# Opcional: endpoint alternativo (por defecto https://freebuff.com/api/v1/paid)
FREEBUFF_BASE_URL=
# OpenCode Zen / otros
OPENCODE_API_KEY=
# Ollama local — /api/ollama/*
OLLAMA_HOST=http://localhost:11434

# ── Notas ─────────────────────────────────────────────────────
# • Las keys también pueden gestionarse en caliente desde la UI
#   (se guardan en cookies httpOnly vía /api/keys, nunca en localStorage).
# • Las variables de aquí son el fallback cuando no hay key de sesión.
# • XAI_API_KEY y HF_API_TOKEN son solo de cliente (cookies httpOnly),
#   no hace falta declararlas aquí.
# • En Electron solo se usa ELECTRON_START_URL (lo pone electron:dev).
# • Si una key se ha expuesto (p. ej. quedó escrita en .env), RÓTALA en la
#   consola del proveedor y pega la nueva vía UI o aquí.
#
# ── Seguridad del agente ────────────────────────────────────────
# code.run está DESHABILITADO por defecto (el sandbox `vm` no es una frontera
# real). Solo actívalo si confías en el código que el agente va a ejecutar:
# AGENT_ALLOW_CODE_RUN=1
# Modo estricto de red: además de metadata/link-local/privadas (siempre
# bloqueadas), bloquea también loopback en web.fetch y mcp.*. OJO: rompe
# Ollama local y los MCP en localhost:
# AGENT_STRICT_NET=1
